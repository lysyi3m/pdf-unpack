# ── macOS ──
.DS_Store

# ── Xcode build output & user state ──
build/
DerivedData/
*.dmg
*.xcuserstate
xcuserdata/
*.moved-aside

# ── Generated by XcodeGen (source of truth is project.yml) ──
# The .xcodeproj and any generated Info.plist / entitlements are regenerated by
# `xcodegen generate`, so they are not tracked.
*.xcodeproj/
Config/*.plist
Config/*.entitlements

# ── Swift Package Manager ──
.build/
.swiftpm/

# ── Coding-agent guidance is shared, not personal ──
# The global ignore drops CLAUDE.md and .claude everywhere; both are project
# guidance here. The shared allowlist is tracked, the per-machine one is not.
!CLAUDE.md
!.claude/
!.claude/settings.json
.claude/settings.local.json

# ── Repo-specific ──
# Python (the fixture generator under tools/).
__pycache__/
*.pyc
.venv/
venv/
# Sensitive / real PDFs — NEVER commit. The synthetic fixtures under fixtures/
# are safe and ARE committed; put a real document under fixtures/real/ instead.
fixtures/real/
*.private.pdf
