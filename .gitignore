# ── macOS ──
.DS_Store

# ── Xcode build output & user state ──
build/
DerivedData/
*.dmg
*.xcuserstate
xcuserdata/
*.moved-aside

# ── Generated by XcodeGen (source of truth is project.yml) ──
# The .xcodeproj, Info.plist, and entitlements are all regenerated by
# `xcodegen generate`, so they are not tracked.
*.xcodeproj/
Config/Info.plist
Config/*.entitlements

# ── Swift Package Manager (if ever added) ──
.build/
.swiftpm/

# ── Python ──
__pycache__/
*.pyc
.venv/
venv/

# ── Local-only tooling (not committed) ──
/tools/

# ── Sensitive / real PDFs — NEVER commit ──
# The synthetic fixture (fixtures/sample-protected.pdf) is safe and IS committed.
# Put the real document you're actually unpacking under fixtures/real/ instead.
fixtures/real/
*.private.pdf
